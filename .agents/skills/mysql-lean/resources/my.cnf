# Perfil low-memory para apps chicas/medianas (MariaDB LTS o MySQL LTS).
# Punto de partida: ajustar con métricas reales.
[mysqld]
# --- Memoria ---
performance_schema       = OFF     # en MySQL ahorra cientos de MB; en MariaDB ya viene OFF
innodb_buffer_pool_size  = 128M    # ~ tamaño de datos calientes, piso 64M
innodb_log_buffer_size   = 8M
key_buffer_size          = 8M      # solo MyISAM; casi no se usa
tmp_table_size           = 16M
max_heap_table_size      = 16M
sort_buffer_size         = 256K
join_buffer_size         = 256K
read_buffer_size         = 128K

# --- Conexiones ---
max_connections          = 30      # alinear con el pool del backend
thread_cache_size        = 4
table_open_cache         = 256
table_definition_cache   = 256
skip_name_resolve        = ON

# --- Charset ---
character_set_server     = utf8mb4
collation_server         = utf8mb4_unicode_ci   # en MySQL podés usar utf8mb4_0900_ai_ci

# --- Seguridad básica ---
local_infile             = OFF
bind_address             = 0.0.0.0              # exponer solo en la red interna de Docker, nunca publicar el puerto
